# Supabase — lấy từ Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anthropic — lấy từ console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Admin auth
ADMIN_PASSWORD=chorquanh2025
NEXT_PUBLIC_ADMIN_HASH=admin-chorquanh2025

# Site URL (dùng cho SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://leviethoang.shop

# Google Analytics 4 — lấy từ Google Analytics > Admin > Data Streams > Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense — lấy từ AdSense > Tài khoản > Thông tin tài khoản > Mã nhà xuất bản
# Định dạng: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX

# Google Search Console verification — lấy từ Search Console > Settings > Ownership verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_code_here

# Facebook Pixel — lấy từ Meta Business Manager > Events Manager
NEXT_PUBLIC_FB_PIXEL_ID=your_pixel_id_here

# Facebook Page ID (dùng cho Messenger links)
NEXT_PUBLIC_FB_PAGE_ID=your_fb_page_id_here

# Facebook App — lấy từ developers.facebook.com > Your App > Settings > Basic
# App ID public (dùng cho Facebook Login button)
NEXT_PUBLIC_FB_APP_ID=your_fb_app_id_here
# App Secret private — KHÔNG để lộ ra client
FB_APP_SECRET=your_fb_app_secret_here

# Chợ Tốt integration (tuỳ chọn)
NEXT_PUBLIC_CHOT_TOT_URL=https://cho-tot.com

# Facebook Messenger API — lấy từ Meta for Developers > Page Access Token
# Cần quyền pages_messaging để gửi tin nhắn cho khách
FB_PAGE_ACCESS_TOKEN=your_page_access_token_here

# Thông tin ngân hàng cho QR thanh toán (VietQR)
# Bank ID: MB, VCB, TCB, ACB, VPB, TPB, STB, ... (xem danh sách tại vietqr.io)
NEXT_PUBLIC_BANK_ID=MB
NEXT_PUBLIC_BANK_ACCOUNT=0123456789
NEXT_PUBLIC_BANK_ACCOUNT_NAME=NGUYEN VAN A
