NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anthropic — lấy từ console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Admin auth
ADMIN_PASSWORD=chorquanh2025
NEXT_PUBLIC_ADMIN_HASH=admin-chorquanh2025

# Site URL (dùng cho SEO, sitemap, Open Graph)
