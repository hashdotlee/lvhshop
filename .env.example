# Facebook Pixel — lấy từ Meta Business Manager > Events Manager
NEXT_PUBLIC_FB_PIXEL_ID=your_pixel_id_here

# Facebook Page ID (dùng cho Messenger links)
NEXT_PUBLIC_FB_PAGE_ID=your_fb_page_id_here

# Chợ Tốt integration (tuỳ chọn)
